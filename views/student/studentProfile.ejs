<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | Student Portal</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-slate-50 min-h-screen flex">

    <!-- Sidebar Partial -->
    <%- include("partials/navBar", { activePage: "profile" }) %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 p-8 lg:p-10 overflow-y-auto">

        <!-- Page Header -->
        <div class="flex justify-between items-center mb-8 bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
            <div>
                <h1 class="text-2xl font-bold text-slate-800">My Profile</h1>
                <p class="text-xs text-slate-400 mt-0.5">Manage your student profile and review performance metrics</p>
            </div>
        </div>

        <div class="max-w-4xl mx-auto space-y-8">

            <!-- Hero Profile Banner Card -->
            <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
                <!-- Banner Background -->
                <div class="h-36 bg-gradient-to-r from-emerald-500 to-teal-600 relative">
                    <!-- Dynamic shapes/gradients inside banner for extra premium styling -->
                    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>
                </div>

                <!-- Profile Monogram & Name Block -->
                <div class="px-8 pb-8 relative flex flex-col md:flex-row items-center md:items-end md:space-x-6 -mt-16 text-center md:text-left">
                    <!-- Ring Border Avatar Monogram -->
                    <div class="w-32 h-32 rounded-3xl bg-gradient-to-tr from-emerald-600 to-teal-500 border-4 border-white shadow-xl flex items-center justify-center text-4xl font-black text-white transform hover:scale-105 transition-transform duration-200">
                        <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                    </div>

                    <div class="mt-4 md:mt-0 flex-1 space-y-1">
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
                            <h2 class="text-2xl font-bold text-slate-800"><%= user.name %></h2>
                            <span class="bg-emerald-50 text-emerald-700 text-xxs font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-full border border-emerald-200 shadow-sm">Student</span>
                        </div>
                        <p class="text-sm text-slate-400 font-medium"><%= user.email %></p>
                    </div>
                </div>
            </div>

            <!-- Academic Assignment Stats Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                
                <!-- Stat 1: Total -->
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center space-x-4">
                    <div class="w-10 h-10 bg-slate-50 text-slate-600 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xxs text-slate-400 font-bold uppercase tracking-wider">Total Uploads</p>
                        <p class="text-xl font-bold text-slate-700 mt-0.5"><%= stats.total %></p>
                    </div>
                </div>

                <!-- Stat 2: Approved -->
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center space-x-4">
                    <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0110 21a3.745 3.745 0 01-3.068-1.593 3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xxs text-slate-400 font-bold uppercase tracking-wider">Approved</p>
                        <p class="text-xl font-bold text-slate-700 mt-0.5"><%= stats.approved %></p>
                    </div>
                </div>

                <!-- Stat 3: Submitted / Review -->
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center space-x-4">
                    <div class="w-10 h-10 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xxs text-slate-400 font-bold uppercase tracking-wider">In Review</p>
                        <p class="text-xl font-bold text-slate-700 mt-0.5"><%= stats.submitted %></p>
                    </div>
                </div>

                <!-- Stat 4: Drafts -->
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center space-x-4">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xxs text-slate-400 font-bold uppercase tracking-wider">Drafts</p>
                        <p class="text-xl font-bold text-slate-700 mt-0.5"><%= stats.draft %></p>
                    </div>
                </div>

            </div>

            <!-- Profile Details section Card -->
            <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-100 shadow-sm space-y-6">
                <div>
                    <h3 class="text-lg font-bold text-slate-800">Academic & Profile Details</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Primary registration details linked with department records</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- Item 1: Full Name -->
                    <div class="flex items-center space-x-4 p-4 rounded-2xl bg-slate-50 border border-slate-50 hover:bg-slate-100 hover:border-slate-100 transition-all">
                        <div class="w-10 h-10 bg-white text-slate-500 rounded-xl flex items-center justify-center shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xxs font-bold text-slate-400 uppercase tracking-wider">Full Name</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5"><%= user.name %></p>
                        </div>
                    </div>

                    <!-- Item 2: Email -->
                    <div class="flex items-center space-x-4 p-4 rounded-2xl bg-slate-50 border border-slate-50 hover:bg-slate-100 hover:border-slate-100 transition-all">
                        <div class="w-10 h-10 bg-white text-slate-500 rounded-xl flex items-center justify-center shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xxs font-bold text-slate-400 uppercase tracking-wider">Email Address</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5"><%= user.email %></p>
                        </div>
                    </div>

                    <!-- Item 3: Phone -->
                    <div class="flex items-center space-x-4 p-4 rounded-2xl bg-slate-50 border border-slate-50 hover:bg-slate-100 hover:border-slate-100 transition-all">
                        <div class="w-10 h-10 bg-white text-slate-500 rounded-xl flex items-center justify-center shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xxs font-bold text-slate-400 uppercase tracking-wider">Phone Number</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5"><%= user.phone || 'Not Available' %></p>
                        </div>
                    </div>

                    <!-- Item 4: Department -->
                    <div class="flex items-center space-x-4 p-4 rounded-2xl bg-slate-50 border border-slate-50 hover:bg-slate-100 hover:border-slate-100 transition-all">
                        <div class="w-10 h-10 bg-white text-slate-500 rounded-xl flex items-center justify-center shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 017.882 5.848 50.503 50.503 0 00-2.658.813m-11.166 0A49.793 49.793 0 0012 11.233a49.793 49.793 0 005.918-1.086m-12.75 3.03v3.419c0 .814.546 1.521 1.332 1.716C7.947 18.73 10.191 19 12 19c1.809 0 4.053-.27 5.502-.63a1.875 1.875 0 001.332-1.716v-3.42" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xxs font-bold text-slate-400 uppercase tracking-wider">Department</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5"><%= user.departement %></p>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </main>

</body>
</html>
