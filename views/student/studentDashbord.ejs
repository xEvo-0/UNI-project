<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment Dashboard | Student Portal</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-slate-50 min-h-screen">

    <div class="flex">

        <!-- Sidebar Partial -->
        <%- include("partials/navBar") %>

        <% 
            let Draft = 0; 
            let Approved = 0; 
            let Submitted = 0; 
            let Rejected = 0; 
            let i = 5; 
            
            data.forEach(item => {
                if (item._id === 'Draft') Draft = item.countAssignments;
                if (item._id === 'Approved') Approved = item.countAssignments;
                if (item._id === 'Submitted') Submitted = item.countAssignments;
                if (item._id === 'Rejected') Rejected = item.countAssignments;
            });
        %>

        <!-- Main Content -->
        <main class="flex-1 p-8 lg:p-10 overflow-y-auto">

            <!-- Header -->
            <div class="flex justify-between items-center mb-8 bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">Assignment Dashboard</h1>
                    <p class="text-xs text-slate-400 mt-0.5">Track your assignment approvals and status updates</p>
                </div>
            </div>

            <!-- Stats Boxes (Premium 4-Box Layout with Soft Status Color Fills & Left-Border Accents) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">

                <!-- Draft Card (Golden Yellow) -->
                <div class="bg-amber-50/80 p-6 rounded-2xl border border-amber-200/60 border-l-4 border-l-amber-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-amber-500 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-amber-800 font-bold uppercase tracking-wider">Drafts</p>
                        <p class="text-2xl font-extrabold text-amber-900 mt-0.5"><%= Draft %></p>
                    </div>
                </div>

                <!-- Submitted Card (Orange) -->
                <div class="bg-orange-50/80 p-6 rounded-2xl border border-orange-200/60 border-l-4 border-l-orange-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-orange-500 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-orange-800 font-bold uppercase tracking-wider">Submitted</p>
                        <p class="text-2xl font-extrabold text-orange-900 mt-0.5"><%= Submitted %></p>
                    </div>
                </div>

                <!-- Approved Card (Green) -->
                <div class="bg-emerald-50/80 p-6 rounded-2xl border border-emerald-200/60 border-l-4 border-l-emerald-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-emerald-600 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0110 21a3.745 3.745 0 01-3.068-1.593 3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-emerald-800 font-bold uppercase tracking-wider">Approved</p>
                        <p class="text-2xl font-extrabold text-emerald-900 mt-0.5"><%= Approved %></p>
                    </div>
                </div>

                <!-- Rejected Card (Red) -->
                <div class="bg-rose-50/80 p-6 rounded-2xl border border-rose-200/60 border-l-4 border-l-red-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-rose-500 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-rose-800 font-bold uppercase tracking-wider">Rejected</p>
                        <p class="text-2xl font-extrabold text-rose-900 mt-0.5"><%= Rejected %></p>
                    </div>
                </div>

            </div>

            <!-- Recent Submissions Table/Card Layout -->
            <div class="bg-white p-6.5 rounded-3xl border border-slate-100 shadow-sm space-y-6">

                <div class="flex flex-wrap justify-between items-center gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-800">Recent Uploads</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Quick access to your most recently uploaded assignments</p>
                    </div>

                    <div class="flex flex-wrap gap-3">
                        <!-- Bulk Upload Button -->
                        <a href="/bulk-upload"
                            class="bg-indigo-50 text-indigo-700 hover:bg-indigo-100 px-4.5 py-2.5 rounded-xl text-sm font-semibold transition-all border border-indigo-200">
                            Bulk Upload
                        </a>

                        <!-- Single Upload Button -->
                        <a href="/single-upload"
                            class="bg-emerald-600 text-white hover:bg-emerald-700 px-4.5 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-md hover:shadow-lg flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            New Assignment
                        </a>
                    </div>
                </div>

                <!-- Submissions List (Individual Cards with borders for high contrast and color coding) -->
                <div class="space-y-4">
                    <% assignments.forEach(assignment => { %>
                        <% 
                            let cardBorderClass = "border-slate-150 bg-white hover:border-slate-250 hover:shadow-md"; 
                            if (assignment.status === 'Draft') {
                                cardBorderClass = "border-amber-250 bg-gradient-to-r from-amber-50/15 to-white hover:border-amber-400 hover:shadow-sm";
                            } else if (assignment.status === 'Submitted' || assignment.status === 'Forwarded' || assignment.status === 'Forward') {
                                cardBorderClass = "border-orange-300 bg-gradient-to-r from-orange-100/25 to-white hover:border-orange-400 hover:shadow-sm";
                            } else if (assignment.status === 'Approved') {
                                cardBorderClass = "border-emerald-250 bg-gradient-to-r from-emerald-50/15 to-white hover:border-emerald-400 hover:shadow-sm";
                            } else if (assignment.status === 'Rejected') {
                                cardBorderClass = "border-rose-300 bg-gradient-to-r from-rose-100/25 to-white hover:border-rose-455 hover:shadow-sm";
                            }
                        %>
                        <div class="flex flex-wrap items-center justify-between p-4.5 border-2 rounded-2xl transition-all duration-200 <%= cardBorderClass %>">

                            <div class="flex items-center space-x-4">
                                <!-- File Icon color coded to status -->
                                <% 
                                    let iconColor = "text-slate-400 bg-slate-50"; 
                                    if (assignment.status === 'Draft') iconColor = "text-amber-500 bg-amber-50";
                                    else if (assignment.status === 'Submitted' || assignment.status === 'Forwarded' || assignment.status === 'Forward') iconColor = "text-orange-500 bg-orange-50";
                                    else if (assignment.status === 'Approved') iconColor = "text-emerald-500 bg-emerald-50";
                                    else if (assignment.status === 'Rejected') iconColor = "text-rose-500 bg-rose-50";
                                %>
                                <div class="w-10 h-10 rounded-xl flex items-center justify-center <%= iconColor %>">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-slate-700">
                                        Assignment <%= i %> – <%= assignment.title %>
                                    </p>
                                    <p class="text-xxs text-slate-400 font-medium uppercase tracking-wider mt-0.5">
                                        Category: <%= assignment.category %>
                                    </p>
                                </div>
                            </div>

                            <!-- Right actions / badge -->
                            <div class="flex items-center space-x-4">
                                <% if (assignment.status === 'Draft' || assignment.status === 'Rejected') { %>
                                    <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-xs font-semibold shadow-md hover:shadow-lg transition-all open-submit-modal-btn"
                                        data-assignment-id="<%= assignment._id %>"
                                        data-assignment-title="<%= assignment.title %>"
                                        onclick="openSubmitModal(this.getAttribute('data-assignment-id'), this.getAttribute('data-assignment-title'));">
                                        <%= assignment.status === 'Rejected' ? 'Resubmit for Review' : 'Submit for Review' %>
                                    </button>
                                <% } else { %>
                                    <!-- Otherwise Show Status Badge -->
                                    <% 
                                        let badgeClass = "bg-slate-100 text-slate-600 border-slate-200"; 
                                        if (assignment.status === "Submitted") { 
                                            badgeClass = "bg-orange-100 text-orange-800 border-orange-300"; 
                                        } else if (assignment.status === "Forwarded" || assignment.status === "Forward") { 
                                            badgeClass = "bg-orange-100 text-orange-850 border-orange-300"; 
                                        } else if (assignment.status === "Approved") { 
                                            badgeClass = "bg-emerald-50 text-emerald-700 border-emerald-200"; 
                                        } else if (assignment.status === "Rejected") { 
                                            badgeClass = "bg-rose-100 text-rose-800 border-rose-300"; 
                                        } 
                                    %>
                                    <span class="px-3 py-1 border rounded-full text-xs font-bold uppercase tracking-wider <%= badgeClass %>">
                                        <%= assignment.status === "Forwarded" ? "Forwarded to HOD" : assignment.status %>
                                    </span>
                                <% } %>

                                <!-- Preview Link Icon -->
                                <a href="/preview/<%= assignment._id %>" 
                                   class="p-2 text-slate-400 hover:text-emerald-600 hover:bg-slate-100 rounded-xl transition-all"
                                   title="Preview Assignment">
                                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </a>
                            </div>

                        </div>
                        <% i--; %>
                    <% }); %>
                </div>

                <a href="/allAssignments" class="block text-sm font-semibold text-emerald-700 hover:text-emerald-800 mt-4 transition-colors">
                    View All Assignments →
                </a>

            </div>

        </main>

    </div>

    <!-- Include Modal Dialog Partial -->
    <%- include("partials/submitModal") %>

</body>
</html>