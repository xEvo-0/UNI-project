<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Assignments | Student Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/output.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .animate-fade-in-up {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-slate-50 via-slate-100 to-indigo-50/20 min-h-screen text-slate-800">

    <div class="flex">

        <!-- Sidebar -->
        <%- include("partials/navBar", { activePage: "assignments" }) %>

        <!-- MAIN CONTENT -->
        <main class="flex-1 p-8 lg:p-10 overflow-y-auto animate-fade-in-up">

            <!-- Page Header -->
            <div class="flex justify-between items-center mb-8 bg-white/70 backdrop-blur-md p-6 rounded-2xl border border-slate-200/50 shadow-sm transition-all duration-300 hover:shadow-md">
                <div>
                    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">My Assignments</h1>
                    <p class="text-xs text-slate-600 font-semibold mt-1">Manage and track all your assignment evaluation requests in one place</p>
                </div>
            </div>

            <!-- Interactive Status Overview Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
                <!-- All Cards -->
                <div onclick="selectStatusFilter('')" 
                     class="group p-4 rounded-2xl border-2 cursor-pointer transition-all duration-300 hover:shadow-md hover:-translate-y-1 <%= status === '' ? 'border-slate-800 shadow-sm bg-slate-100/90' : 'bg-slate-50/50 hover:bg-slate-100/60 border-slate-150/80 hover:border-slate-350' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xxs font-extrabold text-slate-700 uppercase tracking-wider">All</span>
                        <div class="w-7 h-7 bg-slate-150 text-slate-800 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-slate-800">All Statuses</span>
                </div>

                <!-- Draft -->
                <div onclick="selectStatusFilter('Draft')" 
                     class="group p-4 rounded-2xl border-2 cursor-pointer transition-all duration-300 hover:shadow-md hover:-translate-y-1 <%= status === 'Draft' ? 'border-yellow-500 shadow-sm bg-yellow-100/50' : 'bg-yellow-50/30 hover:bg-yellow-50/60 border-slate-150/80 hover:border-yellow-350' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xxs font-extrabold text-yellow-800 uppercase tracking-wider">Draft</span>
                        <div class="w-7 h-7 bg-yellow-100 text-yellow-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                            </svg>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-slate-850">Drafts Only</span>
                </div>

                <!-- Submitted -->
                <div onclick="selectStatusFilter('Submitted')" 
                     class="group p-4 rounded-2xl border-2 cursor-pointer transition-all duration-300 hover:shadow-md hover:-translate-y-1 <%= status === 'Submitted' ? 'border-orange-500 shadow-sm bg-orange-100/50' : 'bg-orange-50/30 hover:bg-orange-50/60 border-slate-150/80 hover:border-orange-350' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xxs font-extrabold text-orange-850 uppercase tracking-wider">Submitted</span>
                        <div class="w-7 h-7 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                            </svg>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-slate-850">Submitted</span>
                </div>

                <!-- Forwarded -->
                <div onclick="selectStatusFilter('Forwarded')" 
                     class="group p-4 rounded-2xl border-2 cursor-pointer transition-all duration-300 hover:shadow-md hover:-translate-y-1 <%= status === 'Forwarded' ? 'border-blue-600 shadow-sm bg-blue-100/50' : 'bg-blue-50/30 hover:bg-blue-50/60 border-slate-150/80 hover:border-blue-350' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xxs font-extrabold text-blue-800 uppercase tracking-wider">Forwarded</span>
                        <div class="w-7 h-7 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 15l3-3m0 0l-3-3m3 3h-7.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-slate-850">To HOD</span>
                </div>

                <!-- Approved -->
                <div onclick="selectStatusFilter('Approved')" 
                     class="group p-4 rounded-2xl border-2 cursor-pointer transition-all duration-300 hover:shadow-md hover:-translate-y-1 <%= status === 'Approved' ? 'border-green-600 shadow-sm bg-green-100/50' : 'bg-green-50/30 hover:bg-green-50/60 border-slate-150/80 hover:border-green-350' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xxs font-extrabold text-green-800 uppercase tracking-wider">Approved</span>
                        <div class="w-7 h-7 bg-green-100 text-green-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-slate-850">Approved</span>
                </div>

                <!-- Rejected -->
                <div onclick="selectStatusFilter('Rejected')" 
                     class="group p-4 rounded-2xl border-2 cursor-pointer transition-all duration-300 hover:shadow-md hover:-translate-y-1 <%= status === 'Rejected' ? 'border-red-600 shadow-sm bg-red-100/50' : 'bg-red-50/30 hover:bg-red-50/60 border-slate-150/80 hover:border-red-355' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xxs font-extrabold text-red-800 uppercase tracking-wider">Rejected</span>
                        <div class="w-7 h-7 bg-red-100 text-red-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-slate-850">Rejected</span>
                </div>
            </div>

            <!-- Filters Section -->
            <form method="GET" class="flex flex-wrap gap-4 mb-8 items-center bg-white/50 backdrop-blur-md p-4 rounded-2xl border border-slate-200/40 shadow-sm">

                <!-- Status Filter -->
                <div class="flex flex-col gap-1 min-w-[150px]">
                    <span class="text-[10px] font-black text-slate-800 uppercase tracking-wider ml-1">Status</span>
                    <select name="status"
                        class="p-2.5 border border-slate-300 bg-white rounded-xl text-sm focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 outline-none transition cursor-pointer text-slate-900 font-bold">
                        <option value="">All Statuses</option>
                        <option value="Draft" <%=status==='Draft' ? 'selected' : '' %>>Draft</option>
                        <option value="Submitted" <%=status==='Submitted' ? 'selected' : '' %>>Submitted</option>
                        <option value="Forwarded" <%=status==='Forwarded' ? 'selected' : '' %>>Forwarded to HOD</option>
                        <option value="Approved" <%=status==='Approved' ? 'selected' : '' %>>Approved</option>
                        <option value="Rejected" <%=status==='Rejected' ? 'selected' : '' %>>Rejected</option>
                    </select>
                </div>

                <!-- Sort -->
                <div class="flex flex-col gap-1 min-w-[150px]">
                    <span class="text-[10px] font-black text-slate-800 uppercase tracking-wider ml-1">Sort By</span>
                    <select name="sort"
                        class="p-2.5 border border-slate-300 bg-white rounded-xl text-sm focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 outline-none transition cursor-pointer text-slate-900 font-bold">
                        <option value="newest" <%=sort==='newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="oldest" <%=sort==='oldest' ? 'selected' : '' %>>Oldest First</option>
                    </select>
                </div>

                <div class="flex items-end self-stretch pt-5">
                    <button class="px-6 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 text-white rounded-xl shadow-md shadow-emerald-500/10 hover:shadow-lg hover:shadow-emerald-500/20 hover:from-emerald-700 hover:to-teal-700 text-sm font-semibold transition active:scale-95 cursor-pointer flex items-center gap-1.5 h-[42px]">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                        </svg>
                        Filter
                    </button>
                </div>

            </form>

            <!-- Table Container -->
            <div class="overflow-x-auto p-1">

                <table class="min-w-full text-sm border-separate border-spacing-y-3">
                    <thead class="text-slate-800 uppercase tracking-wider text-xxs font-black">
                        <tr>
                            <th class="py-2 px-6 text-left pb-1">Assignment Title</th>
                            <th class="py-2 px-6 text-left pb-1">Category</th>
                            <th class="py-2 px-6 text-left pb-1">Status</th>
                            <th class="py-2 px-6 text-left pb-1">Submitted Date</th>
                            <th class="py-2 px-6 text-left pb-1">Reviewer / Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if(assignments.length===0) { %>
                            <tr>
                                <td colspan="5" class="text-center py-16 bg-white rounded-2xl border border-slate-100/80 text-slate-800 font-bold shadow-sm">
                                    <div class="flex flex-col items-center justify-center space-y-2">
                                        <svg class="w-10 h-10 text-slate-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 012.008 1.24l.885 1.77a2.25 2.25 0 002.007 1.24h1.98a2.25 2.25 0 002.007-1.24l.885-1.77a2.25 2.25 0 012.007-1.24h3.86m-18 0h18" />
                                        </svg>
                                        <span>No assignments found.</span>
                                    </div>
                                </td>
                            </tr>
                        <% } %>

                        <% assignments.forEach(a => { %>

                        <!-- Clickable Card Row -->
                        <tr class="group hover:bg-slate-50/20 cursor-pointer"
                            data-href="/preview/<%= a._id %>">

                            <!-- Title (with Document Icon) -->
                            <td class="px-6 py-4.5 bg-white border-y border-slate-100/60 first:border-l first:rounded-l-2xl shadow-[0_1px_2px_rgba(0,0,0,0.02)] group-hover:bg-slate-50/50 group-hover:border-slate-200/80 transition-all duration-300 font-bold text-slate-800">
                                <div class="flex items-center space-x-3">
                                    <div class="w-9 h-9 bg-slate-50 group-hover:bg-white text-slate-600 group-hover:text-emerald-500 rounded-xl flex items-center justify-center shadow-inner group-hover:scale-105 transition-all duration-300">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                        </svg>
                                    </div>
                                    <span class="group-hover:text-emerald-600 transition-colors duration-300"><%= a.title %></span>
                                </div>
                            </td>

                            <!-- Category -->
                            <td class="px-6 py-4.5 bg-white border-y border-slate-100/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)] group-hover:bg-slate-50/50 group-hover:border-slate-200/80 transition-all duration-300 font-bold text-slate-800">
                                <span class="px-2.5 py-1 bg-slate-100 group-hover:bg-white text-slate-855 text-xs rounded-lg border border-slate-200 capitalize font-extrabold">
                                    <%= a.category %>
                                </span>
                            </td>

                            <!-- Status Badge (Preserving Exact Colors) -->
                            <td class="px-6 py-4.5 bg-white border-y border-slate-100/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)] group-hover:bg-slate-50/50 group-hover:border-slate-200/80 transition-all duration-300">
                                <%
                                    let color = 'bg-gray-500';
                                    let label = a.status;

                                    if (a.status === 'Draft') {
                                        color = 'bg-yellow-500';
                                    } else if (a.status === 'Submitted') {
                                        color = 'bg-orange-500';
                                    } else if (a.status === 'Forwarded') {
                                        color = 'bg-blue-600';
                                        label = 'Forwarded to HOD';
                                    } else if (a.status === 'Approved') {
                                        color = 'bg-green-600';
                                    } else if (a.status === 'Rejected') {
                                        color = 'bg-red-600';
                                    }
                                %>
                                <span class="text-white px-3.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider inline-block shadow-sm <%= color %>">
                                    <%= label %>
                                </span>
                            </td>

                            <!-- Submitted Date -->
                            <td class="px-6 py-4.5 bg-white border-y border-slate-100/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)] group-hover:bg-slate-50/50 group-hover:border-slate-200/80 transition-all duration-300 font-bold text-slate-800">
                                <div class="flex items-center space-x-1.5">
                                    <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span><%= a.submittedAt ? new Date(a.submittedAt).toLocaleDateString() : "-" %></span>
                                </div>
                            </td>

                            <!-- Reviewer OR Submit Action Button -->
                            <td class="px-6 py-4.5 bg-white border-y border-slate-100/60 last:border-r last:rounded-r-2xl shadow-[0_1px_2px_rgba(0,0,0,0.02)] group-hover:bg-slate-50/50 group-hover:border-slate-200/80 transition-all duration-300">
                                <% if (a.status === "Draft") { %>
                                    <button class="bg-blue-600 text-white px-4 py-2 rounded-xl text-xs font-semibold shadow hover:bg-blue-700 active:scale-95 hover:shadow-lg transition-all duration-200 open-submit-modal-btn cursor-pointer"
                                            data-assignment-id="<%= a._id %>"
                                            data-assignment-title="<%= a.title %>"
                                            onclick="event.stopPropagation(); openSubmitModal(this.getAttribute('data-assignment-id'), this.getAttribute('data-assignment-title'));">
                                        Submit for Review
                                    </button>
                                <% } else if (a.status === "Rejected") { %>
                                    <button class="bg-blue-600 text-white px-4 py-2 rounded-xl text-xs font-semibold shadow hover:bg-blue-700 active:scale-95 hover:shadow-lg transition-all duration-200 open-submit-modal-btn cursor-pointer"
                                            data-assignment-id="<%= a._id %>"
                                            data-assignment-title="<%= a.title %>"
                                            onclick="event.stopPropagation(); openSubmitModal(this.getAttribute('data-assignment-id'), this.getAttribute('data-assignment-title'));">
                                        Resubmit for Review
                                    </button>
                                <% } else { %>
                                    <div class="flex items-center space-x-1.5">
                                        <div class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></div>
                                        <span class="font-extrabold text-slate-900 text-xs"><%= a.currentReviewer || "-" %></span>
                                    </div>
                                <% } %>
                            </td>

                        </tr>

                        <% }) %>
                    </tbody>
                </table>

            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="flex justify-center mt-8 space-x-2">

                    <% if (page > 1) { %>
                        <a href="?page=<%= page-1 %>&status=<%= status %>&sort=<%= sort %>"
                           class="px-4 py-2.5 bg-white border border-slate-350 text-slate-800 rounded-xl text-sm font-bold hover:bg-slate-50 hover:text-slate-955 hover:border-slate-400 shadow-sm active:scale-95 transition-all flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                            </svg>
                            Prev
                        </a>
                    <% } %>

                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <a href="?page=<%= i %>&status=<%= status %>&sort=<%= sort %>"
                           class="px-4 py-2.5 rounded-xl text-sm font-bold shadow-sm active:scale-95 transition-all border 
                           <%= i === page ? 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white border-emerald-600 hover:from-emerald-700 hover:to-teal-700 shadow-emerald-500/10' : 'bg-white text-slate-800 border-slate-350 hover:bg-slate-50 hover:text-slate-955 hover:border-slate-400' %>">
                            <%= i %>
                        </a>
                    <% } %>

                    <% if (page < totalPages) { %>
                        <a href="?page=<%= page+1 %>&status=<%= status %>&sort=<%= sort %>"
                           class="px-4 py-2.5 bg-white border border-slate-350 text-slate-800 rounded-xl text-sm font-bold hover:bg-slate-50 hover:text-slate-955 hover:border-slate-400 shadow-sm active:scale-95 transition-all flex items-center gap-1">
                            Next
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                            </svg>
                        </a>
                    <% } %>

                </div>
            <% } %>

        </main>
    </div>

    <!-- Clickable Row Script -->
    <script>
        document.querySelectorAll("tr[data-href]").forEach(row => {
            row.addEventListener("click", () => {
                window.location = row.dataset.href;
            });
        });
        function selectStatusFilter(statusVal) {
            const selectEl = document.querySelector('select[name="status"]');
            if (selectEl) {
                selectEl.value = statusVal;
                selectEl.closest('form').submit();
            }
        }
    </script>

    <%- include("partials/submitModal") %>

</body>
</html>
