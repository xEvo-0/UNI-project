<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professor Dashboard | Professor Portal</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-slate-50 min-h-screen">

    <div class="flex">

        <!-- Sidebar -->
        <%- include("partials/navBar", { activePage: "dashboard" }) %>

        <% 
            let Submitted = 0; 
            let Approved = 0; 
            let Rejected = 0; 
            
            stats.statusWise.forEach(status => {
                if (status._id === "Submitted") Submitted = status.count;
                else if (status._id === "Approved") Approved = status.count;
                else if (status._id === "Rejected") Rejected = status.count;
            });
        %>

        <!-- MAIN CONTENT -->
        <main class="flex-1 p-8 lg:p-10 overflow-y-auto">

            <!-- Header -->
            <div class="flex justify-between items-center mb-8 bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">Professor Dashboard</h1>
                    <p class="text-xs text-slate-400 mt-0.5">Evaluate assignments and manage student approval metrics</p>
                </div>
            </div>

            <!-- STATS CARDS (Premium 4-Box Layout with Soft Status Color Fills & Left-Border Accents) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">

                <!-- Pending Reviews (Submitted - Orange) -->
                <div class="bg-orange-50/80 p-6 rounded-2xl border border-orange-200/60 border-l-4 border-l-orange-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-orange-500 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-orange-800 font-bold uppercase tracking-wider">Pending</p>
                        <p class="text-2xl font-extrabold text-orange-900 mt-0.5"><%= Submitted %></p>
                    </div>
                </div>

                <!-- Approved (Green) -->
                <div class="bg-emerald-50/80 p-6 rounded-2xl border border-emerald-200/60 border-l-4 border-l-emerald-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-emerald-600 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0110 21a3.745 3.745 0 01-3.068-1.593 3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-emerald-800 font-bold uppercase tracking-wider">Approved</p>
                        <p class="text-2xl font-extrabold text-emerald-900 mt-0.5"><%= Approved %></p>
                    </div>
                </div>

                <!-- Rejected (Red) -->
                <div class="bg-rose-50/80 p-6 rounded-2xl border border-rose-200/60 border-l-4 border-l-red-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-rose-500 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-rose-800 font-bold uppercase tracking-wider">Rejected</p>
                        <p class="text-2xl font-extrabold text-rose-900 mt-0.5"><%= Rejected %></p>
                    </div>
                </div>

                <!-- Total Reviewed (Blue) -->
                <div class="bg-blue-50/80 p-6 rounded-2xl border border-blue-200/60 border-l-4 border-l-blue-500 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 bg-white text-blue-600 rounded-xl flex items-center justify-center shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs text-blue-800 font-bold uppercase tracking-wider">Total Reviewed</p>
                        <p class="text-2xl font-extrabold text-blue-900 mt-0.5"><%= stats.totalAssignments[0]?.total || 0 %></p>
                    </div>
                </div>

            </div>

            <!-- ASSIGNMENTS AWAITING REVIEW -->
            <div class="bg-white p-6 md:p-7 rounded-3xl border border-slate-100 shadow-sm space-y-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-800">Assignments Awaiting Review</h2>
                    <p class="text-xs text-slate-400 mt-0.5">Evaluation queue for student uploads targeting your review</p>
                </div>

                <!-- Awaiting Reviews list as individual cards with distinct borders for better contrast -->
                <div class="space-y-4">

                    <% if (pendingAssignments && pendingAssignments.length > 0) { %>

                        <% pendingAssignments.forEach(a => { %>
                            <div class="flex flex-wrap items-center justify-between p-5 border-2 border-slate-150 bg-white rounded-2xl hover:border-slate-350 hover:shadow-md transition-all duration-200">

                                <div class="flex items-center space-x-4">
                                    <!-- Document Graphic Icon -->
                                    <div class="w-10 h-10 bg-indigo-50 text-indigo-500 rounded-xl flex items-center justify-center shadow-inner">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-slate-700">
                                            <%= a.submittedBy || 'Student' %> – <%= a.title %>
                                        </p>
                                        <p class="text-xxs text-slate-400 font-medium uppercase tracking-wider mt-1 flex items-center gap-1.5">
                                            <span>Category: <%= a.category %></span>
                                            <span>•</span>
                                            <span class="text-orange-600 font-bold bg-orange-50 px-2 py-0.5 rounded-md border border-orange-100"><%= a.daysPending || 0 %> days pending</span>
                                        </p>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex items-center gap-3">
                                    <a href="/professor/review/<%= a._id %>"
                                       class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-all shadow-md hover:shadow-lg flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        Evaluate
                                    </a>

                                    <a href="/preview/<%= a._id %>"
                                       class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-all border border-slate-200">
                                        Preview
                                    </a>
                                </div>

                            </div>
                        <% }) %>

                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-12 text-slate-400 bg-white border-2 border-slate-100 rounded-2xl">
                            <svg class="w-12 h-12 stroke-current mb-2 opacity-50" fill="none" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="text-sm font-medium italic">No assignments pending for your review.</p>
                        </div>
                    <% } %>

                </div>

                <a href="/professor/myReview" class="block text-sm font-semibold text-emerald-700 hover:text-emerald-800 mt-4 transition-colors">
                    View All Assignments →
                </a>
            </div>

        </main>

    </div>

</body>
</html>