<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OTP Verification - Assignment Portal</title>
  <!-- Google Fonts for Modern Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/output.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>

<body class="h-full flex flex-col items-center justify-center p-6 bg-[#13152a] text-slate-900 antialiased">

  <div class="w-full max-w-[440px] p-8 sm:p-10 bg-white rounded-[2rem] shadow-2xl transition-all duration-300">
    
    <!-- Branding Header -->
    <div class="flex flex-col items-center mb-8 text-center">
      <div class="w-14 h-14 rounded-2xl bg-[#4b49e5] text-white flex items-center justify-center shadow-lg shadow-indigo-150 mb-4">
        <!-- SVG Shield Check Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-[#1e293b] leading-tight">Verify Your OTP</h1>
      <p class="text-sm text-[#7a819b] mt-1.5 font-medium">Enter the 5-digit code sent to your email</p>
    </div>

    <!-- OTP Form -->
    <form action="/verifyOTP" method="POST" class="flex flex-col gap-6">
      <div class="flex justify-between gap-2.5">
        <input name="otp[]" type="text" maxlength="1"
          class="otp-input w-12 h-12 border border-slate-200 rounded-xl text-center text-xl font-bold bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-800" />
        <input name="otp[]" type="text" maxlength="1"
          class="otp-input w-12 h-12 border border-slate-200 rounded-xl text-center text-xl font-bold bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-800" />
        <input name="otp[]" type="text" maxlength="1"
          class="otp-input w-12 h-12 border border-slate-200 rounded-xl text-center text-xl font-bold bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-800" />
        <input name="otp[]" type="text" maxlength="1"
          class="otp-input w-12 h-12 border border-slate-200 rounded-xl text-center text-xl font-bold bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-800" />
        <input name="otp[]" type="text" maxlength="1"
          class="otp-input w-12 h-12 border border-slate-200 rounded-xl text-center text-xl font-bold bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-800" />
      </div>

      <button type="submit"
        class="w-full bg-[#4b49e5] hover:bg-indigo-700 text-white font-bold py-3.5 px-4 rounded-2xl shadow-md hover:shadow-lg transition-all cursor-pointer text-sm tracking-wide">
        Verify Code
      </button>
    </form>

    <!-- Resend Link -->
    <p class="text-center text-slate-500 text-sm mt-6 font-medium">
      Didn't receive the code?
      <a href="/verifyOTP" class="text-[#4b49e5] hover:text-indigo-700 font-semibold transition-all hover:underline">Resend</a>
    </p>
  </div>

  <script src="/js/sweetalert2.all.min.js"></script>
  <script>
    window.onload = () => {
      document.querySelectorAll(".otp-input").forEach(input => {
        input.value = "";
      });
      document.querySelectorAll(".otp-input")[0].focus();
    };

    const inputs = document.querySelectorAll(".otp-input");

    // Auto move between inputs
    inputs.forEach((input, index) => {
      input.addEventListener("input", () => {
        if (input.value.length === 1 && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
      });

      input.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && index > 0 && input.value === "") {
          inputs[index - 1].focus();
        }
      });
    });

    // ---- MODAL LOGIC WITH SWEETALERT2 ----
    const msg = "<%= msg %>"; // Coming from backend

    if (msg === "wrong") {
      Swal.fire({
        title: 'Incorrect OTP',
        text: 'The OTP code you entered is wrong. Please check your email and try again.',
        icon: 'error',
        confirmButtonColor: '#e11d48', // rose-600
        confirmButtonText: 'Try Again'
      });
    }
  </script>

</body>

</html>