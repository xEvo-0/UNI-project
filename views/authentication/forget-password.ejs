<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forget Password - Assignment Portal</title>
  <!-- Google Fonts for Modern Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/output.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>

<body class="h-full flex flex-col items-center justify-center p-6 bg-[#13152a] text-slate-900 antialiased">

  <div class="w-full max-w-[440px] p-8 sm:p-10 bg-white rounded-[2rem] shadow-2xl transition-all duration-300">

    <!-- Wrong OTP Alert Modal with Local SweetAlert2 -->
    <% if (typeof msg !== 'undefined' && msg === 'wrong') { %>
      <script src="/js/sweetalert2.all.min.js"></script>
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          Swal.fire({
            title: 'Error!',
            text: 'Wrong OTP! Please try again.',
            icon: 'error',
            confirmButtonColor: '#e11d48', // rose-600
            confirmButtonText: 'Try Again'
          });
        });
      </script>
    <% } %>

    <!-- Email Step -->
    <% if (step === 'email') { %>
      <!-- Branding Header -->
      <div class="flex flex-col items-center mb-8 text-center">
        <div class="w-14 h-14 rounded-2xl bg-[#4b49e5] text-white flex items-center justify-center shadow-lg shadow-indigo-150 mb-4">
          <!-- SVG Lock Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-[#1e293b] leading-tight">Forget Password</h1>
        <p class="text-sm text-[#7a819b] mt-1.5 font-medium">Recover access to your account</p>
      </div>

      <form action="/send-otp" method="POST" class="flex flex-col gap-5">
        <div class="form-group flex flex-col">
          <label for="email" class="text-sm font-semibold text-[#334155] mb-2">Email Address</label>
          <div class="relative flex items-center">
            <div class="absolute left-4 pointer-events-none flex items-center justify-center">
              <!-- Envelope SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <input 
              type="email" 
              id="email" 
              name="email" 
              placeholder="name@university.edu" 
              class="w-full pl-12 pr-4 py-3.5 border border-slate-200 rounded-2xl bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm text-slate-800 transition-all placeholder-slate-400" 
              required
            >
          </div>
        </div>

        <button type="submit" class="w-full mt-3 bg-[#4b49e5] hover:bg-indigo-700 text-white font-bold py-3.5 px-4 rounded-2xl shadow-md hover:shadow-lg transition-all cursor-pointer text-sm tracking-wide">
          Send OTP
        </button>

        <div class="text-center mt-3">
          <a href="/login" class="text-[#4b49e5] hover:text-indigo-700 font-semibold transition-all text-sm">Back to Sign In</a>
        </div>
      </form>

    <!-- OTP Verification Step -->
    <% } else if (step === 'otp') { %>
      <div class="flex flex-col items-center mb-8 text-center">
        <div class="w-14 h-14 rounded-2xl bg-[#4b49e5] text-white flex items-center justify-center shadow-lg shadow-indigo-150 mb-4">
          <!-- SVG Key/Shield Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-[#1e293b] leading-tight">Verify OTP</h1>
        <p class="text-sm text-[#7a819b] mt-1.5 font-medium">Enter the code sent to your email</p>
      </div>

      <form action="/verify-otp" method="POST" class="flex flex-col gap-5">
        <input type="hidden" name="email" value="<%= email %>">
        
        <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4 text-center">
          <p class="text-xs text-indigo-700 font-medium">We sent a verification code to:<br><strong class="text-indigo-900"><%= email %></strong></p>
        </div>

        <div class="form-group flex flex-col">
          <label for="otp" class="text-sm font-semibold text-[#334155] mb-2">Verification Code</label>
          <div class="relative flex items-center">
            <div class="absolute left-4 pointer-events-none flex items-center justify-center">
              <!-- Lock SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <input 
              type="text" 
              id="otp" 
              name="otp" 
              placeholder="Enter OTP code" 
              class="w-full pl-12 pr-4 py-3.5 border border-slate-200 rounded-2xl bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm text-slate-800 transition-all placeholder-slate-400" 
              required
            >
          </div>
        </div>

        <button type="submit" class="w-full mt-3 bg-[#4b49e5] hover:bg-indigo-700 text-white font-bold py-3.5 px-4 rounded-2xl shadow-md hover:shadow-lg transition-all cursor-pointer text-sm tracking-wide">
          Verify OTP
        </button>

        <div class="text-center mt-3">
          <a href="/login" class="text-[#4b49e5] hover:text-indigo-700 font-semibold transition-all text-sm">Back to Sign In</a>
        </div>
      </form>

    <!-- Reset Password Step -->
    <% } else if (step === 'newPassword') { %>
      <div class="flex flex-col items-center mb-8 text-center">
        <div class="w-14 h-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center shadow-lg shadow-emerald-150 mb-4">
          <!-- SVG Check/Shield Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-[#1e293b] leading-tight">Reset Password</h1>
        <p class="text-sm text-[#7a819b] mt-1.5 font-medium">Create a strong password for your account</p>
      </div>

      <form action="/reset-password" method="POST" class="flex flex-col gap-5">
        <input type="hidden" name="email" value="<%= email %>">

        <div class="form-group flex flex-col">
          <label for="password" class="text-sm font-semibold text-[#334155] mb-2">New Password</label>
          <div class="relative flex items-center">
            <div class="absolute left-4 pointer-events-none flex items-center justify-center">
              <!-- Lock SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <input 
              type="password" 
              id="password" 
              name="password" 
              placeholder="••••••••" 
              class="w-full pl-12 pr-4 py-3.5 border border-slate-200 rounded-2xl bg-[#f8fafc] focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 text-sm text-slate-800 transition-all placeholder-slate-400" 
              required
            >
          </div>
        </div>

        <button type="submit" class="w-full mt-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-4 rounded-2xl shadow-md hover:shadow-lg transition-all cursor-pointer text-sm tracking-wide">
          Reset Password
        </button>
      </form>
    <% } %>

  </div>

</body>

</html>
