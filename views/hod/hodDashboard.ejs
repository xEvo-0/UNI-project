<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>HOD Dashboard | HOD Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/output.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .animate-fade-in-up {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-slate-50 via-slate-100 to-indigo-50/20 min-h-screen text-slate-800">

<div class="flex">
    
    <!-- Sidebar -->
    <%- include("partials/hodNavbar", { activePage: "dashboard" }) %>

    <!-- Main Content -->
    <main class="flex-1 p-8 lg:p-10 overflow-y-auto animate-fade-in-up">

        <!-- Page Header -->
        <div class="flex justify-between items-center mb-8 bg-white/70 backdrop-blur-md p-6 rounded-2xl border border-slate-200/50 shadow-sm transition-all duration-300 hover:shadow-md">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">HOD Dashboard</h1>
                <p class="text-xs text-slate-600 font-semibold mt-1">Manage and track your department evaluation requests and metrics</p>
            </div>
        </div>

        <!-- Extract status values -->
        <% 
            let Submitted = 0, Approved = 0, Rejected = 0; 
            if(stats?.statusWise){
                stats.statusWise.forEach(s=>{
                    if(s._id==="Submitted" || s._id==="Forwarded") Submitted = s.count;
                    if(s._id==="Approved") Approved = s.count;
                    if(s._id==="Rejected") Rejected = s.count;
                });
            }
            let Total = stats?.totalAssignments?.[0]?.total || 0;
        %>

        <!-- STATS CARDS (Premium 4-Box Layout with Soft Status Color Fills & Left-Border Accents) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">

            <!-- Pending Reviews (Submitted - Orange) -->
            <div class="bg-orange-50/80 p-6 rounded-2xl border border-orange-200/60 border-l-4 border-l-orange-500 shadow-sm flex items-center space-x-4">
                <div class="w-12 h-12 bg-white text-orange-500 rounded-xl flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs text-orange-855 font-bold uppercase tracking-wider">Pending</p>
                    <p class="text-2xl font-extrabold text-orange-900 mt-0.5"><%= Submitted %></p>
                </div>
            </div>

            <!-- Approved (Green) -->
            <div class="bg-emerald-50/80 p-6 rounded-2xl border border-emerald-200/60 border-l-4 border-l-emerald-500 shadow-sm flex items-center space-x-4">
                <div class="w-12 h-12 bg-white text-emerald-600 rounded-xl flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0110 21a3.745 3.745 0 01-3.068-1.593 3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs text-emerald-855 font-bold uppercase tracking-wider">Approved</p>
                    <p class="text-2xl font-extrabold text-emerald-900 mt-0.5"><%= Approved %></p>
                </div>
            </div>

            <!-- Rejected (Red) -->
            <div class="bg-rose-50/80 p-6 rounded-2xl border border-rose-200/60 border-l-4 border-l-red-500 shadow-sm flex items-center space-x-4">
                <div class="w-12 h-12 bg-white text-rose-500 rounded-xl flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs text-rose-850 font-bold uppercase tracking-wider">Rejected</p>
                    <p class="text-2xl font-extrabold text-rose-900 mt-0.5"><%= Rejected %></p>
                </div>
            </div>

            <!-- Total Reviewed (Blue) -->
            <div class="bg-blue-50/80 p-6 rounded-2xl border border-blue-200/60 border-l-4 border-l-blue-500 shadow-sm flex items-center space-x-4">
                <div class="w-12 h-12 bg-white text-blue-600 rounded-xl flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs text-blue-855 font-bold uppercase tracking-wider">Total Queue</p>
                    <p class="text-2xl font-extrabold text-blue-900 mt-0.5"><%= Total %></p>
                </div>
            </div>

        </div>

        <!-- Pending Assignments -->
        <section class="mb-12 bg-white p-6 md:p-7 rounded-3xl border border-slate-100 shadow-sm space-y-6">
            <div>
                <h2 class="text-lg font-bold text-slate-800">Assignments Awaiting Review</h2>
                <p class="text-xs text-slate-500 mt-0.5">Evaluation queue for student uploads targeting department HOD review</p>
            </div>

            <div class="space-y-4">

                <% if(pendingAssignments?.length > 0){ %>

                    <% pendingAssignments.forEach(a => { %>
                    <div class="flex flex-col md:flex-row justify-between items-center p-5 border-2 border-slate-150 bg-white rounded-2xl hover:border-slate-350 hover:shadow-md transition duration-200">

                        <div class="flex items-center space-x-4">
                            <div class="w-10 h-10 bg-indigo-50 text-indigo-500 rounded-xl flex items-center justify-center shadow-inner">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-slate-800">
                                    <%= a.submittedBy || 'Student' %> — 
                                    <span class="text-slate-600 italic font-semibold"><%= a.title %></span>
                                </p>

                                <p class="text-xxs text-slate-500 font-semibold uppercase tracking-wider mt-1 flex items-center gap-1.5">
                                    <span>Submitted: <%= a.submittedAt ? new Date(a.submittedAt).toLocaleDateString() : "-" %></span>
                                    <span>•</span>
                                    <% 
                                        let daysPending = 0;
                                        if (a.submittedAt) {
                                            daysPending = Math.max(0, Math.floor((Date.now() - new Date(a.submittedAt)) / (1000 * 60 * 60 * 24)));
                                        }
                                    %>
                                    <span class="text-orange-600 font-bold bg-orange-50 px-2 py-0.5 rounded-md border border-orange-100"><%= daysPending %> days pending</span>
                                </p>
                            </div>
                        </div>

                        <div class="flex space-x-3 mt-3 md:mt-0">
                            <a href="/hod/review/<%= a._id %>"
                               class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-bold rounded-xl transition duration-200 shadow-md hover:shadow-lg">
                                Review Assignment
                            </a>
                        </div>
                    </div>
                    <% }) %>

                <% } else { %>
                    <div class="flex flex-col items-center justify-center py-12 text-slate-400 bg-white border-2 border-slate-100 rounded-2xl">
                        <svg class="w-12 h-12 stroke-current mb-2 opacity-50" fill="none" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="text-sm font-bold text-slate-700 italic">No assignments pending for your review.</p>
                    </div>
                <% } %>

            </div>
        </section>

        <a href="/hod/myReview" 
           class="mt-6 inline-block text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors">
            View My Reviews Queue →
        </a>

    </main>
</div>

</body>
</html>
