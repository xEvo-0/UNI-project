<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-100">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users - Assignment Approval System</title>
  <!-- Google Fonts for Modern Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/output.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>

<body class="h-full text-slate-900 antialiased">
  <main class="flex items-start min-h-screen">

    <%- include('partials/leftPartial') %>

    <div id="right" class="flex-1 p-8 lg:p-12 bg-slate-100 min-h-screen overflow-x-auto">

      <!-- HEADER SECTION -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-6 mb-8">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            Users Management
          </h1>
          <p class="text-slate-500 mt-1 text-sm sm:text-base">Search, filter, edit, or remove academic users in the system.</p>
        </div>
        <a href="/addUsers" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-5 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 self-start sm:self-auto text-sm">
          <span>➕</span> Add User
        </a>
      </div>

      <!-- Filters + Search -->
      <div class="filters-container bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm mb-6">

        <form action="/users" method="GET" class="filter-form flex flex-col md:flex-row items-stretch md:items-center gap-4 flex-wrap">

          <!-- Search -->
          <div class="flex-1 min-w-[240px]">
            <input 
              type="text" 
              name="search" 
              placeholder="Search by name or email..."
              value="<%= search || '' %>"
              class="search-input w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm placeholder-slate-400 transition-all"
            />
          </div>

          <!-- Filter by Role -->
          <div class="min-w-[180px]">
            <select name="role" class="filter-select w-full px-4 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm cursor-pointer text-slate-700 transition-all">
              <option value="">All Roles</option>
              <option value="Student" <%= role === 'Student' ? 'selected' : '' %>>Student</option>
              <option value="Professor" <%= role === 'Professor' ? 'selected' : '' %>>Professor</option>
              <option value="HOD" <%= role === 'HOD' ? 'selected' : '' %>>HOD</option>
            </select>
          </div>

          <!-- Filter by Department -->
          <div class="min-w-[200px]">
            <select name="department" class="filter-select w-full px-4 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm cursor-pointer text-slate-700 transition-all">
              <option value="">All Departments</option>
              <% departments.forEach(dep => { %>
                <option 
                  value="<%= dep.departmentName %>" 
                  <%= department === dep.departmentName ? 'selected' : '' %>>
                  <%= dep.departmentName %>
                </option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="apply-btn px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-xl shadow-sm hover:shadow transition-all text-sm cursor-pointer">
            Apply Filters
          </button>

        </form>

      </div>


      <!-- Users Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-200/80 shadow-sm bg-white">
        <table class="users-table w-full border-collapse">
          <thead>
            <tr class="bg-slate-900 border-b border-slate-800">
              <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-300">Name</th>
              <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-300">Email</th>
              <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-300">Role</th>
              <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-300">Department</th>
              <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-300">Status</th>
              <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-300">Actions</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            <% if (users && users.length > 0) { %>

              <% users.forEach((user) => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="px-6 py-4 text-sm font-semibold text-slate-900"><%= user.name %></td>
                  <td class="px-6 py-4 text-sm text-slate-600"><%= user.email %></td>
                  <td class="px-6 py-4 text-sm">
                    <% if (user.role === 'Student') { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                        🎓 <%= user.role %>
                      </span>
                    <% } else if (user.role === 'Professor') { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-100">
                        👨‍🏫 <%= user.role %>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">
                        💼 <%= user.role %>
                      </span>
                    <% } %>
                  </td>

                  <td class="px-6 py-4 text-sm text-slate-500"><%= user.departement || 'N/A' %></td>

                  <td class="px-6 py-4 text-sm">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                      ● Active
                    </span>
                  </td>

                  <td class="px-6 py-4 text-sm font-medium">
                    <div class="flex items-center gap-3">
                      <a href="/editUser/<%= user._id %>" class="inline-flex items-center justify-center px-3.5 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 hover:text-indigo-850 font-bold text-xs rounded-lg border border-indigo-100 transition-all">
                        Edit
                      </a>

                      <form id="delete-user-form-<%= user._id %>"
                            action="/deleteUser/<%= user._id %>" 
                            method="POST"
                            style="display:inline;">
                        <button type="button" onclick="confirmDeleteUser('<%= user._id %>')" class="inline-flex items-center justify-center px-3.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 hover:text-rose-850 font-bold text-xs rounded-lg border border-rose-100 transition-all cursor-pointer">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>

            <% } else { %>

              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-sm text-slate-500 font-medium">No users found matching filters.</td>
              </tr>

            <% } %>

          </tbody>

        </table>
      </div>


      <!-- Pagination -->
      <div class="pagination flex items-center justify-center gap-2 mt-8">

        <% if (currentPage > 1) { %>
          <a href="/users?page=<%= currentPage - 1 %>&search=<%= search %>&role=<%= role %>&department=<%= department %>" class="px-4 py-2 border border-slate-200 text-sm font-semibold rounded-xl text-slate-700 bg-white hover:bg-slate-50 transition-all shadow-sm">
            Previous
          </a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <a 
            href="/users?page=<%= i %>&search=<%= search %>&role=<%= role %>&department=<%= department %>" 
            class="px-4 py-2 border text-sm font-bold rounded-xl transition-all shadow-sm <%= currentPage === i ? 'bg-indigo-600 border-indigo-600 text-white font-extrabold hover:bg-indigo-700 shadow-indigo-200' : 'border-slate-200 text-slate-700 bg-white hover:bg-slate-50' %>">
            <%= i %>
          </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="/users?page=<%= currentPage + 1 %>&search=<%= search %>&role=<%= role %>&department=<%= department %>" class="px-4 py-2 border border-slate-200 text-sm font-semibold rounded-xl text-slate-700 bg-white hover:bg-slate-50 transition-all shadow-sm">
            Next
          </a>
        <% } %>

      </div>

    </div>

  </main>
  
  <script src="/js/sweetalert2.all.min.js"></script>
  <script>
    function confirmDeleteUser(userId) {
      Swal.fire({
        title: 'Are you sure?',
        text: "Do you really want to delete this user account?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#4f46e5', // indigo-600
        cancelButtonColor: '#e11d48',  // rose-600
        confirmButtonText: 'Yes, delete user!',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          document.getElementById('delete-user-form-' + userId).submit();
        }
      })
    }
  </script>
</body>

</html>
