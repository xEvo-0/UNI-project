<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-100">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Update Department - Assignment Approval System</title>
  <!-- Google Fonts for Modern Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/output.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>

<body class="h-full text-slate-900 antialiased">
  <main class="flex items-start min-h-screen">
    <%- include('partials/leftPartial') %>

    <div id="right" class="flex-1 p-8 lg:p-12 bg-slate-100 min-h-screen flex flex-col items-center">
      
      <form class="dept-form bg-white rounded-2xl border border-slate-200 p-8 shadow-md max-w-xl w-full hover:shadow-lg transition-all duration-300 flex flex-col gap-6" action="/update-dept/<%= deptData._id %>" method="POST">
        
        <!-- Form Header -->
        <div class="flex items-center gap-3.5 border-b border-slate-100 pb-5 mb-2">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-lg border border-indigo-100">
            🏢
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-800">Update Department Details</h2>
            <p class="text-xs text-slate-400">Modify department name, programme type, and location block.</p>
          </div>
        </div>

        <div class="form-group flex flex-col">
          <label for="deptName" class="text-sm font-semibold text-slate-750 mb-2">Department Name</label>
          <input 
            type="text" 
            id="deptName" 
            name="deptName" 
            value="<%= deptData.departmentName %>" 
            placeholder="e.g. Computer Science and Engineering" 
            class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm transition-all placeholder-slate-400 bg-slate-50/50 focus:bg-white text-slate-800" 
            required
          >
        </div>

        <div class="form-group flex flex-col">
          <label for="programType" class="text-sm font-semibold text-slate-750 mb-2">Program Type</label>
          <select 
            id="programType" 
            name="programType" 
            class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm transition-all bg-slate-50/50 focus:bg-white text-slate-700 cursor-pointer" 
            required
          >
            <option value="Undergraduate" <%=(deptData.programmeType==="Undergraduate" )? "selected" : "" %>>Undergraduate</option>
            <option value="Postgraduate"<%=(deptData.programmeType==="Postgraduate" )? "selected" : "" %>>Postgraduate</option>
            <option value="Research" <%=(deptData.programmeType==="Research" )? "selected" : "" %>>Research</option>
          </select>
        </div>

        <div class="form-group flex flex-col">
          <label for="address" class="text-sm font-semibold text-slate-750 mb-2">Address / Block Location</label>
          <textarea 
            id="address" 
            name="address" 
            rows="3" 
            placeholder="e.g. Ramanujan Block, 3rd Floor" 
            class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm transition-all placeholder-slate-400 bg-slate-50/50 focus:bg-white resize-y text-slate-800" 
            required
          ><%= deptData.address %></textarea>
        </div>

        <button type="submit" class="submit-btn w-full mt-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer text-sm tracking-wide">
          Update Department
        </button>
      </form>
    </div>
  </main>
</body>

</html>
